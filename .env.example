# ==============================================================================
# free-dp Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your API keys:
#   cp .env.example .env
#
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL!
# ==============================================================================

E2B_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 1. Google AI Studio / Gemini Free API Keys (Recommended: 3-10 keys)
#    https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# ------------------------------------------------------------------------------
# 2. Groq Cloud Free API Keys (Fast Analytical Worker Pool: 1-3 keys)
#    https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ------------------------------------------------------------------------------
# 3. OpenRouter Free API Keys (High-Context Empirical Fallback: 1-3 keys)
#    https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# ------------------------------------------------------------------------------
# 4. Hugging Face Inference Keys (Optional: 1-3 keys)
#    https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY_1=
HUGGINGFACE_API_KEY_2=
HUGGINGFACE_API_KEY_3=

# ------------------------------------------------------------------------------
# 5. Cloudflare Workers AI & R2 Storage (Optional)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_KEY_1=
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_API_KEY_2=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_KEY_3=
CLOUDFLARE_ACCOUNT_ID_3=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 6. Tavily AI Search API (Optional, falls back to DuckDuckGo)
#    https://tavily.com
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
